<%@ Page Title="Order" Language="C#" MasterPageFile="~/Site.Master" AutoEventWireup="true" CodeBehind="Order.aspx.cs" Inherits="WebApplication5.Order" %>
<asp:Content ID="Content1" ContentPlaceHolderID="MainContent" runat="server">
<h1>Your cart</h1><p>Practice checkout with fictional details. No payment or delivery.</p><div class="checkout"><section class="panel"><h2>Order details</h2><label for="<%= txtName.ClientID %>">Demo customer name</label><asp:TextBox ID="txtName" runat="server" MaxLength="80" /><p>We do not collect shipping addresses, phone numbers or payment details.</p><asp:Button ID="btnPlaceOrder" runat="server" Text="Place demo order" OnClick="btnPlaceOrder_Click" /><asp:Button ID="btnClear" runat="server" Text="Clear cart" OnClick="ClearCart" CausesValidation="false" CssClass="secondary" /><p role="status"><asp:Label ID="lblOrder" runat="server" /></p></section><section class="panel"><h2>Summary</h2><asp:Label ID="lblSummary" runat="server" /><h3><asp:Label ID="lblTotal" runat="server" /></h3><a href="Products.aspx">Continue browsing</a></section></div>
</asp:Content>
