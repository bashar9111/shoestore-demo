<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="WebApplication5.SiteMaster" %>
<!DOCTYPE html><html lang="en"><head runat="server"><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>ShoeStore Demo</title><link href="Content/Site.css" rel="stylesheet" /></head>
<body><a class="skip" href="#main">Skip to content</a><form id="form1" runat="server"><header><a class="logo" href="Home.aspx">ShoeStore<span> / Demo</span></a><nav aria-label="Main navigation"><a href="Products.aspx">Collection</a><a href="Order.aspx">Cart</a><a href="OrderManagement.aspx">My orders</a><% if(Request.IsAuthenticated) { %><span class="username"><%: Context.User.Identity.Name %></span><asp:LinkButton ID="LogoutButton" runat="server" OnClick="Unnamed_LoggingOut" CausesValidation="false">Sign out</asp:LinkButton><% } else { %><a href="Login.aspx">Sign in</a><a href="Register.aspx">Create account</a><% } %></nav></header><div class="notice">A student demonstration. Fictional products. No real purchases.</div><main id="main"><asp:ContentPlaceHolder ID="MainContent" runat="server" /></main><footer><strong>ShoeStore Demo</strong><span>University project &#183; Restored &amp; improved &#183; 2026</span></footer></form></body></html>
